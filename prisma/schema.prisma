// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // When running `prisma migrate` locally or in CI, Prisma creates a shadow
  // database to safely run migrations. With Neon you should point this to
  // a writable database (often a separate Neon branch) using an env var:
  // shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Certificate {
  id          String              @id @default(cuid())
  title       String
  issuer      String
  date        String
  description String
  skills      String[] // Array of skill tags
  /// Certificate level (entry/intermediate/advanced). Optional so existing rows aren't affected.
  level       CertificationLevel?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([level])
  @@map("certificates")
}

model Project {
  id           String      @id @default(cuid())
  title        String
  description  String
  category     String // "Software Engineering", "AI/ML", "Others"
  technologies String[] // Array of tech tags
  githubLink   String?
  liveLink     String?
  imageUrl     String?
  images       String[]    @default([]) // Array of image URLs for modal gallery
  caseStudies  CaseStudy[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([category])
  @@map("projects")
}

model CaseStudy {
  id           String      @id @default(cuid())
  slug         String      @unique
  title        String
  role         String?
  summary      String
  problem      String
  /// Array<{ title: string; chose: string; rejected?: string; why: string }>
  decisions    Json        @default("[]")
  architecture String?
  ops          String?
  reflections  String?
  liveUrl      String?
  repoUrl      String?
  stack        String[]    @default([])
  experienceId String?
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  featured     Boolean     @default(false)
  order        Int         @default(0)
  /// Groups the homepage Projects section: ACTIVE first, then WIP, then DISCONTINUED.
  status       CaseStudyStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([featured, order])
  @@map("case_studies")
}

enum CaseStudyStatus {
  ACTIVE
  WIP
  DISCONTINUED
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  /// Free-text category. Null = uncategorized; UI groups by this value.
  category    String?
  proficiency String?
  context     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("skills")
}

enum CertificationLevel {
  ENTRY
  INTERMEDIATE
  ADVANCED
}

model Badge {
  id        String   @id @default(cuid())
  title     String
  issuer    String
  date      String
  badgeUrl  String? // link to Credly badge or embed URL
  imageUrl  String?
  skills    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@map("badges")
}

model Experience {
  id           String        @id @default(cuid())
  company      String
  role         String?
  location     String?
  description  String
  outcomes     String?
  stack        String[]      @default([])
  startDate    DateTime
  /// Null means "Present" (current role).
  endDate      DateTime?
  testimonials Testimonial[]
  caseStudies  CaseStudy[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([startDate(sort: Desc)])
  @@map("experiences")
}

/// Every contact-form submission. Doubles as the rate-limit ledger
/// (per-IP hourly and global daily counts in app/api/contact/route.ts).
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  ip        String
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("contact_messages")
}

model Testimonial {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  authorName   String
  authorRole   String?
  quote        String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([experienceId])
  @@map("testimonials")
}
